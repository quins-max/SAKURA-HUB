                    if ThemeDropdown then pcall(function() ThemeDropdown:SetValue(_G_CONFIG.Theme) end) end
                end
                notify("Preset Imported\nConfiguration updated successfully in real time!", 4)
            else
                notify("Import Failed\nInvalid shareable string format.", 4)
            end
        else
            notify("Error\nShareable string input slot is empty.", 3)
        end
    end
})

