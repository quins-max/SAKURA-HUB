local function loadPreset(name)
    local path = "VibeIncHubConfigs/" .. name .. ".json"
    if isfile(path) then
        local success, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
        if success and type(data) == "table" then
            for k, v in pairs(data) do 
                _G_CONFIG[k] = v 
                setUIValue(k, v)
            end
            if _G_CONFIG.AutoBuySpeed and SPEED_MAP[_G_CONFIG.AutoBuySpeed] then
                autoBuySpeed = SPEED_MAP[_G_CONFIG.AutoBuySpeed]
                if AutoBuySpeedDropdown then pcall(function() AutoBuySpeedDropdown:SetValue(_G_CONFIG.AutoBuySpeed) end) end
            end
            if _G_CONFIG.AutoUpgradeSpeed and SPEED_MAP[_G_CONFIG.AutoUpgradeSpeed] then
                autoUpgradeSpeed = SPEED_MAP[_G_CONFIG.AutoUpgradeSpeed]
                if AutoUpgradeSpeedDropdown then pcall(function() AutoUpgradeSpeedDropdown:SetValue(_G_CONFIG.AutoUpgradeSpeed) end) end
            end
            if _G_CONFIG.Theme then
                pcall(function() windUI:SetTheme(_G_CONFIG.Theme) end)
                if ThemeDropdown then pcall(function() ThemeDropdown:SetValue(_G_CONFIG.Theme) end) end
            end
            notify("Config Loaded\nLoaded profile: " .. name, 3)
        else
            notify("Error\nFailed to parse config file.", 4)
        end
    end
end

