local StatsGroup = InformationTab:AddLeftGroupbox("Session Statistics")
local TimerLabel = StatsGroup:AddLabel("Play Time: 00h:00m:00s")

local function updateLabel(label, text)
    if label and label.SetText then
        label:SetText(text)
    elseif label and label.Text then
        label.Text = text
    end
end

task.spawn(function()
    while _G_CONFIG.ScriptRunning do
        local seconds = math.floor(tick() - StartTime)
        local h = math.floor(seconds / 3600)
        local m = math.floor((seconds % 3600) / 60)
        local s = seconds % 60
        updateLabel(TimerLabel, "Play Time: " .. string.format("%02dh:%02dm:%02ds", h, m, s))
        task.wait(1)
    end
end)

